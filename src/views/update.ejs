<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Редактирование — Библиотека</title>
  <style>
    body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
    .btn { display: inline-block; padding: 8px 14px; margin-right: 8px; margin-top: 8px;
           background: #335eea; color: #fff; text-decoration: none;
           border: none; border-radius: 6px; cursor: pointer; }
    form label { display: block; margin-top: 12px; font-weight: bold; }
    form input[type="text"], form textarea, form input[type="file"] {
      width: 100%; padding: 8px; margin-top: 4px; box-sizing: border-box; }
    form textarea { height: 100px; }
  </style>
</head>
<body>
  <h1>Редактировать книгу</h1>

  <form action="/books/<%= book.id %>/update" method="POST" enctype="multipart/form-data">
    <label for="title">Название</label>
    <input type="text" id="title" name="title" value="<%= book.title %>" required>

    <label for="authors">Авторы</label>
    <input type="text" id="authors" name="authors" value="<%= book.authors %>" required>

    <label for="description">Описание</label>
    <textarea id="description" name="description"><%= book.description %></textarea>

    <label for="favorite">
      <input type="checkbox" id="favorite" name="favorite" value="true"
             <%= book.favorite ? 'checked' : '' %>> Любимая книга
    </label>

    <label for="fileCover">Новая обложка (оставьте пустым, чтобы не менять)</label>
    <input type="file" id="fileCover" name="fileCover" accept="image/*">

    <label for="fileBook">Новый файл книги (оставьте пустым, чтобы не менять)</label>
    <input type="file" id="fileBook" name="fileBook">

    <p>
      <button type="submit" class="btn">Сохранить</button>
      <a class="btn" href="/books/<%= book.id %>">Отмена</a>
    </p>
  </form>
</body>
</html>
