<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title><%= book.title %> — Библиотека</title>
  <style>
    body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin: 12px 0; }
    .btn { display: inline-block; padding: 8px 14px; margin-right: 8px; margin-top: 8px;
           background: #335eea; color: #fff; text-decoration: none;
           border: none; border-radius: 6px; cursor: pointer; }
    .btn-danger { background: #d64545; }
  </style>
</head>
<body>
  <h1><%= book.title %></h1>

  <div class="card">
    <% if (book.fileCover) { %>
      <img src="/uploads/<%= book.fileCover %>" alt="Обложка" width="200">
    <% } %>

    <p><strong>Авторы:</strong> <%= book.authors %></p>
    <p><strong>Описание:</strong> <%= book.description %></p>

    <% if (book.favorite) { %>
      <p>⭐ Любимая книга</p>
    <% } %>

    <% if (book.fileBook) { %>
      <p><a class="btn" href="/books/<%= book.id %>/download">⬇ Скачать книгу</a></p>
    <% } %>
  </div>

  <a class="btn" href="/books/<%= book.id %>/update">✏ Редактировать</a>
  <form action="/books/<%= book.id %>/delete" method="POST" style="display: inline">
    <button type="submit" class="btn btn-danger">🗑 Удалить</button>
  </form>
  <a class="btn" href="/books">← К списку</a>
</body>
</html>
